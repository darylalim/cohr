{
  "format_version": 5,
  "schema": {
    "$defs": {
      "MapActionItem": {
        "additionalProperties": false,
        "properties": {
          "due": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Due"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Owner"
          },
          "task": {
            "title": "Task",
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "title": "MapActionItem",
        "type": "object"
      },
      "NumberRepair": {
        "additionalProperties": false,
        "properties": {
          "original": {
            "title": "Original",
            "type": "string"
          },
          "repaired": {
            "title": "Repaired",
            "type": "string"
          }
        },
        "required": [
          "original",
          "repaired"
        ],
        "title": "NumberRepair",
        "type": "object"
      },
      "SegmentNotes": {
        "additionalProperties": false,
        "properties": {
          "action_items": {
            "items": {
              "$ref": "#/$defs/MapActionItem"
            },
            "title": "Action Items",
            "type": "array"
          },
          "decisions": {
            "items": {
              "type": "string"
            },
            "title": "Decisions",
            "type": "array"
          },
          "dropped_dues": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Dropped Dues",
            "type": "array"
          },
          "key_points": {
            "items": {
              "type": "string"
            },
            "title": "Key Points",
            "type": "array"
          },
          "number_repairs": {
            "default": [],
            "items": {
              "$ref": "#/$defs/NumberRepair"
            },
            "title": "Number Repairs",
            "type": "array"
          },
          "open_questions": {
            "items": {
              "type": "string"
            },
            "title": "Open Questions",
            "type": "array"
          },
          "raw": {
            "default": false,
            "title": "Raw",
            "type": "boolean"
          },
          "seg_id": {
            "title": "Seg Id",
            "type": "integer"
          },
          "slide_conflicts": {
            "default": [],
            "items": {
              "$ref": "#/$defs/SlideConflict"
            },
            "title": "Slide Conflicts",
            "type": "array"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "terms": {
            "items": {
              "type": "string"
            },
            "title": "Terms",
            "type": "array"
          },
          "unverified_numbers": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Unverified Numbers",
            "type": "array"
          }
        },
        "required": [
          "seg_id",
          "summary",
          "key_points",
          "decisions",
          "action_items",
          "open_questions",
          "terms"
        ],
        "title": "SegmentNotes",
        "type": "object"
      },
      "SlideConflict": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "slide": {
            "title": "Slide",
            "type": "string"
          },
          "spoken": {
            "title": "Spoken",
            "type": "number"
          }
        },
        "required": [
          "label",
          "spoken",
          "slide"
        ],
        "title": "SlideConflict",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "notes": {
        "items": {
          "$ref": "#/$defs/SegmentNotes"
        },
        "title": "Notes",
        "type": "array"
      },
      "target_language": {
        "title": "Target Language",
        "type": "string"
      }
    },
    "required": [
      "target_language",
      "notes"
    ],
    "title": "MapFile",
    "type": "object"
  }
}
